amends "https://sake92.github.io/deder/config/v0.23.0/DederProject.pkl"

local const apiModules = new CreateScalaModules {
  id = "api"
  root = "modules/api"
  layout = "sbt"
  template = new {
    scalaVersion = "3.9.0"
    mainClass = "com.example.petclinic.main.apiMain"
    forkEnv {
      ["JDBC_URL"] = read?("env:JDBC_URL") ?? "jdbc:postgresql://localhost:5432/petclinic"
      ["DB_USER"] = read?("env:DB_USER") ?? "petclinic"
      ["DB_PASSWORD"] = read?("env:DB_PASSWORD") ?? "petclinic"
      ["DB_POOL_SIZE"] = read?("env:DB_POOL_SIZE") ?? "10"
    }
    deps {
      "ba.sake::sharaf-potateh:0.24.0"
      "ba.sake::tupson-config:0.32.1"
      "ba.sake::squery:0.12.0"
      "com.zaxxer:HikariCP:7.1.0"
      "org.flywaydb:flyway-core:11.11.0"
      "org.flywaydb:flyway-database-postgresql:11.11.0"
      "org.postgresql:postgresql:42.7.13"
      "org.webjars:swagger-ui:5.20.1"
    }
    graalvm {
      nativeImageOptions {
        "--no-fallback"
        "-march=compatibility"
        "-J-Xmx4g"
        "-H:IncludeResources=META-INF/resources/webjars/.*"
      }
    }
  }
}.get

local const clientModules = new CreateScalaModules {
  id = "client"
  root = "modules/client"
  layout = "sbt"
  template = new {
    scalaVersion = "3.9.0"
    deps {
      "ba.sake::tupson-sttp:0.30.0"
      "ba.sake::validson:0.19.0"
    }
  }
}.get

local const integrationModules = new CreateScalaModules {
  id = "integration"
  testId = "integration-tests"
  root = "modules/integration-tests"
  layout = "sbt"
  template = new {
    scalaVersion = "3.9.0"
    moduleDeps { apiModules.main; clientModules.main }
  }
  testTemplate = (template.asTest()) {
    deps {
      "org.scalameta::munit:1.3.4"
      "org.testcontainers:testcontainers-postgresql:2.0.3"
    }
    testParallelism = 1
  }
}.get

modules { apiModules.main; clientModules.main; integrationModules.main; integrationModules.test }
